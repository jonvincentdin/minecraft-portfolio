# Public client settings only. Never put secret/service-role keys in VITE_*.
# demo: browser-local content, no credentials. supabase: owner sign-in and shared content (see supabase/README.md).
VITE_CONTENT_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public UI gate only; Supabase password authentication and RLS enforce access.
# Set to the enrolled owner's email for the email-first sign-in step.
VITE_OWNER_EMAIL=
