{
  "name": "jvd-world-of-builds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run assets:sync",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "reference": "node scripts/preview-reference.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run assets:sync",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "assets:sync": "node scripts/sync-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "node tests/e2e/smoke.mjs",
    "test:m02": "node tests/e2e/m02.mjs && node tests/e2e/m02-pointer.mjs",
    "test:m03": "node tests/e2e/m03.mjs && node tests/e2e/m03-config.mjs",
    "test:m04": "node tests/e2e/m04.mjs",
    "test:m05": "node tests/e2e/m05.mjs",
    "test:db": "tsx --test tests/db/*.test.ts",
    "test:m06": "node tests/e2e/m06.mjs",
    "test:m06-hosted": "node tests/e2e/m06-hosted.mjs",
    "test:reference": "node scripts/reference-checks.mjs",
    "test:m07": "node tests/e2e/m07.mjs",
    "test:engines": "node tests/e2e/m07-engines.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
